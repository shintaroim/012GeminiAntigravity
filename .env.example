# ==============================================================================
# HON-NEo 環境変数設定テンプレート
# 本ファイルは公開リポジトリにコミットされるテンプレートです。実キーを書き込まないでください。
# 開発時は本ファイルをコピーして `.env.local` を作成してください。
# ==============================================================================

# AI プロバイダー設定 ("mock" | "gemini" | "openai")
AI_PROVIDER=mock
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your-api-key-here

# 音声読み上げ設定 (Google Cloud Text-to-Speech)
# 設定されている場合は高品質なGoogle Neural2音声で読み上げます。未設定時はブラウザ標準音声にフォールバックします。
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here
GOOGLE_TTS_VOICE=ja-JP-Neural2-B

# セッション・セキュリティ
SESSION_TOKEN_SECRET=replace-with-a-secure-random-secret-at-least-32-chars

# データベース接続 (Supabase / PostgreSQL)
# 設定されている場合は Supabase を利用し、未設定の場合はローカルファイル(data/honneo-db.json)を利用します。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key
# DATABASE_URL=postgresql://user:password@localhost:5432/honneo

# レート制限・利用量制限
RATE_LIMIT_PER_MINUTE=20
MAX_INPUT_CHARS=2000
MAX_OUTPUT_TOKENS=1500
SESSION_MAX_TURNS=50

# アプリケーション基底URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
