# ==============================================================================
# HON-NEo 環境変数設定テンプレート
# 本ファイルは公開リポジトリにコミットされるテンプレートです。実キーを書き込まないでください。
# 開発時は本ファイルをコピーして `.env.local` を作成してください。
# ==============================================================================

# AI プロバイダー設定 ("mock" | "gemini" | "openai")
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your-api-key-here

# セッション・セキュリティ
SESSION_TOKEN_SECRET=replace-with-a-secure-random-secret-at-least-32-chars

# データベース接続 (MVPでは省略時はインメモリ/ローカル永続化)
# DATABASE_URL=postgresql://user:password@localhost:5432/honneo

# レート制限・利用量制限
RATE_LIMIT_PER_MINUTE=20
MAX_INPUT_CHARS=2000
MAX_OUTPUT_TOKENS=1500
SESSION_MAX_TURNS=50

# アプリケーション基底URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
